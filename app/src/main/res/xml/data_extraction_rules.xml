<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 e successivi: il backup sul cloud esclude foto e video personali (limite di 25 MB per app); il passaggio diretto a un nuovo telefono copia tutto -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="media/" />
  </cloud-backup>
</data-extraction-rules>
